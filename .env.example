# Choose exactly one local OpenAI-compatible provider, or leave blank to use hosted AI.
# Ollama defaults: http://127.0.0.1:11434/v1
# LM Studio defaults: http://127.0.0.1:1234/v1
LOCAL_AI_PROVIDER=ollama
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=llama3.2:3b
LOCAL_AI_API_KEY=ollama

# Point this at the Cardmarket daily price-guide CSV/TSV file URL.
CARDMARKET_PRICE_GUIDE_URL=
